{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build STM32",
			"type": "shell",
			"command": "C:\\Users\\Admin\\bin\\cmake.EXE",
			"args": [
				"--build",
				"${workspaceFolder}\\build\\Debug"
			],
			"problemMatcher": []
		},
		{
			"label": "Flash STM32F446RE",
			"type": "shell",
			"command": "E:\\INTERN\\stm32cube programmer\\bin\\STM32_Programmer_CLI.exe",
			"args": [
				"-c",
				"port=SWD",
				"-w",
				"${workspaceFolder}\\build\\Debug\\motor_joystick.elf",
				"-v",
				"-rst"
			],
			"problemMatcher": []
		},
		{
			"label": "Build and Flash STM32F446RE",
			"type": "shell",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Build STM32",
				"Flash STM32F446RE"
			],
			"problemMatcher": []
		},
		{
			"label": "Push motor_joystick to GitLab dev",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"git remote set-url origin git@gitlab.com:plebctech-group/electronics.git; git fetch origin dev; git push origin HEAD:dev"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Add GitLab remote and push dev",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"git remote add origin git@gitlab.com:plebctech-group/electronics.git; git fetch origin dev; git push origin HEAD:dev"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}